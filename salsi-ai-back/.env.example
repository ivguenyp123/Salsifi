# Salsi — back IA · variables d'environnement (AUCUN secret ici en prod : injecté par ta CI depuis Vault)
# Copie en .env pour un test local, ou mappe ces variables depuis Vault dans ta pipeline.

# Port d'écoute du service
PORT=8080

# Secret partagé avec le front (header X-Salsi-Secret). Recommandé.
# En prod : lu depuis Vault via la CI. Côté front : localStorage 'salsi_ai_secret'.
SALSI_SECRET=change-me

# GCP / Vertex AI
GCP_PROJECT=mon-projet-lcl
GCP_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-pro

# Origine autorisée (CORS). Mets l'URL du hub en prod (ex. https://hub.lcl.example).
ALLOW_ORIGIN=*

# Auth GCP : par ADC. NE METS PAS de clé ici.
#  - En CI/prod : Workload Identity, ou GOOGLE_APPLICATION_CREDENTIALS pointant
#    vers un fichier de credentials monté par Vault (jamais commité).
# GOOGLE_APPLICATION_CREDENTIALS=/vault/secrets/gcp-sa.json
